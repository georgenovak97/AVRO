<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Browser"
    Height="860" Width="1296"
    MinHeight="600" MinWidth="986"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="{DynamicResource BgWindow}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgWindow"      Color="#F0F0F0"/>
        <SolidColorBrush x:Key="BgPanel"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSidebar"     Color="#E4E4E4"/>
        <SolidColorBrush x:Key="BgToolbar"     Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BgInput"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderMain"    Color="#ABABAB"/>
        <SolidColorBrush x:Key="BorderLight"   Color="#D0D0D0"/>
        <SolidColorBrush x:Key="TextMain"      Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#5A5A5A"/>
        <SolidColorBrush x:Key="SelBg"         Color="#CCE8FF"/>
        <SolidColorBrush x:Key="SelBorder"     Color="#3399FF"/>
        <SolidColorBrush x:Key="BtnFace"       Color="#E1E1E1"/>
        <SolidColorBrush x:Key="BtnFaceHov"    Color="#CCE4F7"/>
        <SolidColorBrush x:Key="BtnBorder"     Color="#707070"/>
        <SolidColorBrush x:Key="BtnPressed"    Color="#B9D7F5"/>
        <SolidColorBrush x:Key="BtnPrimary"    Color="#E1E1E1"/>
        <SolidColorBrush x:Key="TreeHoverBg"   Color="#EDEDED"/>
        <SolidColorBrush x:Key="TreeIcon"       Color="#666666"/>
        <SolidColorBrush x:Key="TreeConnector"  Color="#969696"/>
        <SolidColorBrush x:Key="ClearBtnHover" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="ClearBtnPressed" Color="#D0D0D0"/>

        <Geometry x:Key="FolderIcon">M1,4 L6,4 L8,6 L17,6 L17,16 L1,16 Z</Geometry>
        <Geometry x:Key="HistoryIcon">M9,2 A7,7 0 1 0 16,9 M9,5 L9,9 L12,11</Geometry>

        <Style x:Key="TreeExpander" TargetType="ToggleButton">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TreeIcon}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="11" Height="11"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Line x:Name="PlusVertical" X1="5" Y1="2" X2="5" Y2="8"
                                      Stroke="{DynamicResource TreeIcon}" StrokeThickness="1"/>
                                <Line X1="2" Y1="5" X2="8" Y2="5"
                                      Stroke="{DynamicResource TreeIcon}" StrokeThickness="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PlusVertical" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Row" Grid.Row="0" Grid.ColumnSpan="2"
                                    Background="Transparent" Padding="0,1">
                                <Grid Height="19" SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Grid.Column="0" Width="20" Height="19">
                                        <ToggleButton x:Name="Expander"
                                                      Style="{StaticResource TreeExpander}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      IsEnabled="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}}">
                                        </ToggleButton>
                                    </Canvas>
                                    <Path x:Name="NodeIcon" Grid.Column="1" Width="16" Height="16"
                                          Margin="3,1,5,1" VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Data="{StaticResource FolderIcon}" Fill="Transparent"
                                          Stroke="{DynamicResource TreeIcon}" StrokeThickness="1.2"/>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      TextElement.Foreground="{DynamicResource TextMain}"
                                                      Margin="2,0,2,0"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ChildItems" Grid.Row="1" Grid.Column="1"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ChildItems" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NodeIcon" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TreeHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RevitButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnFace}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnFaceHov}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevitButtonPrimary" TargetType="Button" BasedOn="{StaticResource RevitButton}">
            <Setter Property="Background" Value="{DynamicResource BtnPrimary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ClearSearchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                <Setter Property="Background" Value="{DynamicResource ClearBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ClearBtnPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ MAIN (tree | catalog | properties) ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="366" MinWidth="323"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="366" MinWidth="323"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Places / library tree -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource BorderMain}" BorderThickness="0,0,1,0">
                <TreeView x:Name="CategoryTree"
                           Background="{DynamicResource BgSidebar}"
                           Margin="4,8,4,8"/>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderLight}"
                          HorizontalAlignment="Stretch"/>

            <!-- CENTER: folder bar + file list -->
            <Grid Grid.Column="2" Background="{DynamicResource BgPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar row (Папка + path) -->
                <Border Grid.Row="0" Background="{DynamicResource BgToolbar}"
                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblFolder" Grid.Column="0" Text="Папка:"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="BreadcrumbText" Grid.Column="1"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="CountText" Grid.Column="2"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Search with automatic filtering and inline clear button -->
                <Border Grid.Row="1" Background="{DynamicResource BgToolbar}"
                        BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Padding="6,4,30,4"
                                 Height="26"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="SearchHint" Text="Поиск семейств…"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextMuted}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="BtnClearSearch"
                                Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="24" Height="24" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource ClearSearchButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Family grid with previews -->
                <ScrollViewer x:Name="FamilyScrollViewer" Grid.Row="2"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource BgPanel}"
                              Margin="0"
                              Padding="0">
                    <Canvas x:Name="FamilyPanel" Margin="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"/>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource BorderLight}"
                          HorizontalAlignment="Stretch"/>

            <!-- RIGHT: Properties -->
            <Border Grid.Column="4" Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource BorderMain}" BorderThickness="1,0,0,0">
                <Grid Margin="0">
                    <Border
                            Background="{DynamicResource BgPanel}"
                            BorderBrush="{DynamicResource BorderMain}"
                            BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource BgToolbar}"
                                    BorderBrush="{DynamicResource BorderLight}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,5">
                                <TextBlock x:Name="PropsTitle"
                                           Text="Свойства"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextMain}"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="8">
                                <StackPanel>
                                    <TextBlock x:Name="PropsHint"
                                               Text="Выберите семейство"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="11"
                                               Margin="0,0,0,8"/>
                                    <StackPanel x:Name="PropsPanel"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ BOTTOM BAR ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderMain}" BorderThickness="0,1,0,0"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Готово"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMain}" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnSettings"
                            Content="Библиотека" Style="{StaticResource RevitButton}"
                            MinWidth="88" ToolTip="Выбрать папку библиотеки"/>
                    <Button x:Name="BtnReload"
                            Content="Обновить" Style="{StaticResource RevitButton}"
                            MinWidth="88" Margin="6,0,0,0"
                            ToolTip="Пересканировать библиотеку"/>
                    <Button x:Name="BtnLoad"
                            Content="Загрузить" Style="{StaticResource RevitButton}"
                            MinWidth="88" Margin="6,0,0,0"
                            ToolTip="Выбрать семейства для загрузки"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
