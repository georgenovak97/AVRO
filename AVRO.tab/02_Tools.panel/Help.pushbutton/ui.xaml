<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Справка" Height="860" Width="1296" MinHeight="600" MinWidth="900" WindowState="Maximized" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource BgWindow}">
  <Window.Resources>
    <SolidColorBrush x:Key="BgWindow" Color="#F0F0F0"/><SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/><SolidColorBrush x:Key="BgSidebar" Color="#E4E4E4"/><SolidColorBrush x:Key="BgToolbar" Color="#F5F5F5"/><SolidColorBrush x:Key="BgInput" Color="#FFFFFF"/><SolidColorBrush x:Key="BorderMain" Color="#ABABAB"/><SolidColorBrush x:Key="BorderLight" Color="#D0D0D0"/><SolidColorBrush x:Key="TextMain" Color="#1E1E1E"/><SolidColorBrush x:Key="TextMuted" Color="#5A5A5A"/><SolidColorBrush x:Key="SelBg" Color="#CCE8FF"/><SolidColorBrush x:Key="SelBorder" Color="#3399FF"/><SolidColorBrush x:Key="BtnFace" Color="#E1E1E1"/><SolidColorBrush x:Key="BtnFaceHov" Color="#CCE4F7"/><SolidColorBrush x:Key="BtnBorder" Color="#707070"/><SolidColorBrush x:Key="BtnPressed" Color="#B9D7F5"/><SolidColorBrush x:Key="BtnPrimary" Color="#E1E1E1"/><SolidColorBrush x:Key="TreeHoverBg" Color="#EDEDED"/><SolidColorBrush x:Key="ClearBtnHover" Color="#E8E8E8"/><SolidColorBrush x:Key="ClearBtnPressed" Color="#D0D0D0"/><SolidColorBrush x:Key="TreeIcon" Color="#666666"/><SolidColorBrush x:Key="TreeConnector" Color="#969696"/>
    <Style TargetType="TreeView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter Property="Padding" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="Row" Grid.Row="0" Padding="5,3" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ItemsPresenter x:Name="Children" Grid.Row="1" Margin="16,0,0,0" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Children" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelBg}"/></Trigger><Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource TreeHoverBg}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="RevitButton" TargetType="Button"><Setter Property="Background" Value="{DynamicResource BtnFace}"/><Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,5"/><Setter Property="MinHeight" Value="24"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource BgWindow}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="190"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="4"/><ColumnDefinition Width="270" MinWidth="190"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="0,0,1,0"><TreeView x:Name="DocumentTree" Margin="5,8"/></Border><GridSplitter Grid.Column="1" Background="{DynamicResource BorderLight}"/><Grid Grid.Column="2" Background="{DynamicResource BgPanel}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{DynamicResource BgToolbar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1" Padding="9,7"><TextBlock x:Name="PathText" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/></Border><WebBrowser x:Name="MarkdownBrowser" Grid.Row="1"/></Grid><GridSplitter Grid.Column="3" Background="{DynamicResource BorderLight}"/><Border Grid.Column="4" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1,0,0,0"><DockPanel><Border DockPanel.Dock="Top" Background="{DynamicResource BgToolbar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1" Padding="9,7"><TextBlock x:Name="TocTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/></Border><TreeView x:Name="TocTree" Margin="5,8"/></DockPanel></Border></Grid><Border Grid.Row="1" Background="{DynamicResource BgToolbar}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="0,1,0,0" Padding="10,8"><Grid><TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMain}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnDocuments" Style="{StaticResource RevitButton}"/><Button x:Name="BtnRefresh" Style="{StaticResource RevitButton}" Margin="6,0,0,0"/></StackPanel></Grid></Border></Grid>
</Window>
